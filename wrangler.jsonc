{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raymond",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raymond-db",
      "database_id": "c28eabcd-632b-4597-a775-9e936af8e61d",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TELEGRAM_PROXY", "class_name": "TelegramProxy" },
      { "name": "NODE_AGENT", "class_name": "NodeAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TelegramProxy"] },
    { "tag": "v2", "new_sqlite_classes": ["NodeAgent"] }
  ],  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "Raymond"
  }
}
